# Copy this file to .env and fill in your real values. Never commit .env itself.

# Get this from MongoDB Atlas: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/sterling-co?retryWrites=true&w=majority

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

PORT=5000
